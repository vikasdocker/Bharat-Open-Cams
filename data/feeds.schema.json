{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vikasdocker/Bharat-Open-Cams/blob/main/data/feeds.schema.json",
  "title": "Bharat Open Cams feed registry",
  "description": "Catalog entries for public camera feeds whose publisher authorization has been verified. Internet reachability alone is not authorization.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "publisher_name",
      "publisher_url",
      "source_page_url",
      "city",
      "category",
      "viewing_method",
      "authorization",
      "attribution",
      "status",
      "verified_at",
      "review_due_at"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 160
      },
      "description": {
        "type": "string",
        "maxLength": 1000
      },
      "publisher_name": {
        "type": "string",
        "minLength": 2
      },
      "publisher_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "source_page_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "terms_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "city": {
        "type": "string",
        "minLength": 2
      },
      "area": {
        "type": "string",
        "maxLength": 160
      },
      "category": {
        "type": "string",
        "enum": [
          "traffic",
          "tourism",
          "weather",
          "environment",
          "public-venue",
          "other-approved"
        ]
      },
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "viewing_method": {
        "type": "string",
        "enum": [
          "official-link",
          "approved-embed",
          "approved-stream"
        ]
      },
      "viewing_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "authorization": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "authorization_type",
          "reuse_scope",
          "evidence_reference",
          "terms_review_note"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "suspended",
              "removed"
            ]
          },
          "authorization_type": {
            "type": "string",
            "enum": [
              "publisher-terms",
              "written-permission",
              "explicit-public-license",
              "publisher-public-page",
              "publisher-embed-feature"
            ],
            "description": "publisher-embed-feature records a publisher-hosted camera wrapper only when its detail page explicitly provides copyable embed code; it does not authorize extracting or re-hosting upstream media."
          },
          "reuse_scope": {
            "type": "string",
            "enum": [
              "link-only",
              "embedding",
              "redistribution"
            ]
          },
          "evidence_reference": {
            "type": "string",
            "minLength": 5,
            "description": "Public terms URL or non-sensitive evidence reference; never include confidential correspondence or credentials."
          },
          "reviewer": {
            "type": "string"
          },
          "terms_review_note": {
            "type": "string",
            "minLength": 20,
            "description": "Human-readable note explaining why the chosen link/embed/stream method is permitted; do not include confidential correspondence or credentials."
          }
        }
      },
      "attribution": {
        "type": "string",
        "minLength": 2
      },
      "removal_contact_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending-review",
          "approved",
          "suspended",
          "removed"
        ]
      },
      "verified_at": {
        "type": "string",
        "format": "date"
      },
      "review_due_at": {
        "type": "string",
        "format": "date"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "approved"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "authorization": {
              "properties": {
                "status": {
                  "const": "approved"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "viewing_method": {
              "const": "approved-embed"
            }
          },
          "required": [
            "viewing_method"
          ]
        },
        "then": {
          "properties": {
            "authorization": {
              "properties": {
                "reuse_scope": {
                  "enum": [
                    "embedding",
                    "redistribution"
                  ]
                }
              },
              "required": [
                "reuse_scope"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "viewing_method": {
              "const": "approved-stream"
            }
          },
          "required": [
            "viewing_method"
          ]
        },
        "then": {
          "properties": {
            "authorization": {
              "properties": {
                "reuse_scope": {
                  "const": "redistribution"
                }
              },
              "required": [
                "reuse_scope"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "authorization": {
              "properties": {
                "authorization_type": {
                  "enum": [
                    "publisher-terms",
                    "explicit-public-license"
                  ]
                }
              },
              "required": [
                "authorization_type"
              ]
            }
          },
          "required": [
            "authorization"
          ]
        },
        "then": {
          "required": [
            "terms_url"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "authorization": {
              "properties": {
                "authorization_type": {
                  "const": "publisher-public-page"
                }
              },
              "required": [
                "authorization_type"
              ]
            }
          },
          "required": [
            "authorization"
          ]
        },
        "then": {
          "properties": {
            "viewing_method": {
              "const": "official-link"
            },
            "authorization": {
              "properties": {
                "reuse_scope": {
                  "const": "link-only"
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "authorization": {
              "properties": {
                "authorization_type": {
                  "const": "publisher-public-page"
                }
              },
              "required": [
                "authorization_type"
              ]
            }
          },
          "required": [
            "authorization"
          ]
        },
        "then": {
          "not": {
            "required": [
              "viewing_url"
            ]
          }
        }
      }
    ]
  }
}